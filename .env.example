# ─────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────
POSTGRES_USER=aise
POSTGRES_PASSWORD=aise_secret
POSTGRES_DB=aise_db
DATABASE_URL=postgresql+asyncpg://aise:aise_secret@db:5432/aise_db

# ─────────────────────────────────────────────────────────────────
# Redis / Celery
# ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─────────────────────────────────────────────────────────────────
# LLM Provider  (openai | gemini | mock)
# ─────────────────────────────────────────────────────────────────
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o
OPENAI_LLM_TEMPERATURE=0.0
OPENAI_LLM_MAX_TOKENS=2048
LLM_FALLBACK_PROVIDER=mock

# Gemini (optional)
GOOGLE_API_KEY=
GEMINI_LLM_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Anthropic (Phase 4 — leave blank for now)
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────
# Embedding Provider  (openai | local)
# ─────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ─────────────────────────────────────────────────────────────────
# GitHub
# ─────────────────────────────────────────────────────────────────
GITHUB_PAT=ghp_...your-token-here...
# Webhook secret (set this when you configure a webhook in GitHub)
GITHUB_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────
# Retrieval
# ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RETRIEVAL_FINAL_K=5
RERANKER_ENABLED=false
QUERY_CACHE_TTL_SECONDS=86400
# COHERE_API_KEY=  ← optional reranker provider

# ─────────────────────────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────────────────────────
REPOS_CLONE_DIR=/repos

# ─────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=120
API_MAX_REQUEST_BYTES=1000000
EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=1536
